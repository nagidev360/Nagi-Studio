# Frontend (Vite exposes VITE_* values to the browser; never put secrets here)
VITE_API_URL=http://localhost:10000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Backend only: keep these out of frontend variables and Git history
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
TOKEN_ENCRYPTION_KEY=GENERATE_A_32_BYTE_KEY_AS_64_HEX_CHARACTERS
CORS_ORIGIN=http://localhost:5173
PORT=10000
